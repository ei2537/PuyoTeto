{
  "name": "stack-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:production": "npm run build && node scripts/smoke-production.mjs",
    "assets:inspect": "node scripts/inspect-assets.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.html docs/*.md README.md",
    "dev:server": "tsx --env-file=server/.env watch server/index.ts",
    "build:server": "tsc --noEmit && node scripts/build-server.mjs",
    "start:server": "node --env-file-if-exists=server/.env server-dist/index.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
